<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Conteúdo (fica atrás do menu, que abre por cima como no YouTube) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="72dp">

        <!-- Início -->
        <LinearLayout
            android:id="@+id/section_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="32dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_list"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="48dp" />
        </LinearLayout>

        <!-- Busca -->
        <LinearLayout
            android:id="@+id/section_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="32dp">

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/tv_search_field_bg"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/mic"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/tv_round_pill_bg"
                    android:contentDescription="@string/tv_voice"
                    android:focusable="true"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/tv_on_focus" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/suggestions"
                    android:layout_width="280dp"
                    android:layout_height="match_parent"
                    android:paddingStart="24dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_results"
                android:clipChildren="false"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="48dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Inscrições e Favoritos usam o mesmo layout -->
        <LinearLayout
            android:id="@+id/section_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/list_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/history_clear"
                    style="@style/TvPill"
                    android:text="@string/history_clear" />

                <TextView
                    android:id="@+id/history_pause"
                    style="@style/TvPill"
                    android:text="@string/history_pause" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_grid"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:paddingBottom="48dp" />
        </LinearLayout>

        <!-- Você: Histórico e Favoritos em fileiras -->
        <LinearLayout
            android:id="@+id/section_you_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="32dp">

                <TextView
                    android:id="@+id/you_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/you_sync"
                    style="@style/TvPill"
                    android:text="@string/account_sync_now" />

                <TextView
                    android:id="@+id/you_login"
                    style="@style/TvPill"
                    android:text="@string/account_login" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/section_you"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="48dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="48dp"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Escurece o conteúdo quando o menu abre -->
    <View
        android:id="@+id/rail_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/tv_rail_scrim" />

    <!-- Menu lateral -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/rail_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <include
            android:id="@+id/rail_search"
            layout="@layout/tv_rail_item" />

        <include
            android:id="@+id/rail_home"
            layout="@layout/tv_rail_item" />

        <include
            android:id="@+id/rail_subs"
            layout="@layout/tv_rail_item" />

        <include
            android:id="@+id/rail_history"
            layout="@layout/tv_rail_item" />

        <include
            android:id="@+id/rail_you"
            layout="@layout/tv_rail_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/rail_update"
            layout="@layout/tv_rail_item" />

        <TextView
            android:id="@+id/rail_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
