<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:buffered_color="#66FFFFFF"
        app:played_color="#FF0000"
        app:scrubber_color="#FF0000"
        app:unplayed_color="#33FFFFFF"
        app:show_buffering="when_playing" />

    <TextView
        android:id="@+id/seek_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="96dp"
        android:background="@drawable/seek_indicator_bg"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seek_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="96dp"
        android:background="@drawable/seek_indicator_bg"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/overlay_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/tv_title_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="48dp"
        android:paddingTop="32dp"
        android:paddingBottom="56dp">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Painel que aparece com a seta para baixo: ações e fileiras de vídeos sem fim -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/panel_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F20F0F0F"
            android:alpha="0" />

        <LinearLayout
            android:id="@+id/panel_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/tv_bottom_gradient"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingTop="64dp">

            <LinearLayout
                android:id="@+id/actions_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="40dp"
                android:paddingBottom="8dp">

                <include
                    android:id="@+id/action_favorite"
                    layout="@layout/tv_action" />

                <include
                    android:id="@+id/action_save"
                    layout="@layout/tv_action" />

                <include
                    android:id="@+id/action_channel"
                    layout="@layout/tv_action" />

                <include
                    android:id="@+id/action_subscribe"
                    layout="@layout/tv_action" />

                <include
                    android:id="@+id/action_audio"
                    layout="@layout/tv_action" />

                <include
                    android:id="@+id/action_quality"
                    layout="@layout/tv_action" />

                <include
                    android:id="@+id/action_subtitles"
                    layout="@layout/tv_action" />

                <include
                    android:id="@+id/action_next"
                    layout="@layout/tv_action" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panel_rows"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/down_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:shadowColor="#000000"
        android:shadowRadius="4"
        android:text="@string/tv_down_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />
</FrameLayout>
