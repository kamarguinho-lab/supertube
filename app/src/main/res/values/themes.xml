<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SuperTube" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/on_pill_light</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorSurfaceContainer">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SuperTube.Dialog</item>
    </style>

    <style name="ThemeOverlay.SuperTube.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
    </style>

    <!-- Botões em pílula, como os do YouTube -->
    <style name="Pill" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/chip</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="Pill.Light">
        <item name="backgroundTint">@color/pill_light</item>
        <item name="android:textColor">@color/on_pill_light</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CategoryChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="NoIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Tema da versão para TV -->
    <style name="Theme.SuperTube.TV" parent="Theme.SuperTube">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
